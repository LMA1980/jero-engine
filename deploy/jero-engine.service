[Unit]
Description=Jero Engine Isolated Inference Compute Worker
Documentation=https://github.com/LMA1980/jero-engine
Requires=jero-kv-cache.service
After=jero-kv-cache.service

[Service]
Type=simple
Slice=jero-runner.slice
User=jero-runner
Group=jero-runner
WorkingDirectory=/var/lib/jero-runner
EnvironmentFile=-/etc/jero-runner/engine.env
Environment=JERO_STORE_ROOT=/var/lib/jero-runner
ExecStart=/usr/local/bin/jero-engine
Restart=on-failure
RestartSec=5
LimitMEMLOCK=29360128K

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/var/lib/jero-runner
ReadWritePaths=/run/jero-runner
InaccessiblePaths=/etc/shadow /root

[Install]
WantedBy=multi-user.target
